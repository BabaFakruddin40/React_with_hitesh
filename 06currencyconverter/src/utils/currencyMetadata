const getCurrencyMetadata = (code) => {
  const lower = (code || '').toLowerCase();
  return (
    CURRENCY_METADATA[lower] || {
      name: code ? code.toUpperCase() : 'Unknown',
      symbol: code ? code.toUpperCase() : '',
      flag: '🌐',
    }
  );
};

export { getCurrencyMetadata, CURRENCY_METADATA };